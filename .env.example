# OpenProspect environment.
#
# `openprospect init` creates .env from scratch with random passwords, so you usually never
# copy this file by hand. It documents every key. Real environment variables override .env.

# ---------- Service URLs (as seen from the machine running the CLI) ----------
TWENTY_URL=http://localhost:3740
LISTMONK_URL=http://localhost:3741
REACHER_URL=http://localhost:3742
HUGINN_URL=http://localhost:3743
FIRECRAWL_URL=http://localhost:3744

# ---------- Filled in during setup ----------
# Twenty: Settings -> APIs & Webhooks -> Create API key
TWENTY_API_KEY=
# Listmonk API user: created for you by `openprospect setup`
LISTMONK_API_USER=
LISTMONK_API_TOKEN=

# ---------- Sending inbox (agency track, via Listmonk) ----------
# Gmail / Google Workspace: use an app password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=

# ---------- Reply detection (IMAP of the same inbox) ----------
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
# Optional: an older sending inbox, so replies to emails sent from it are still caught
IMAP2_HOST=
IMAP2_USER=
IMAP2_PASSWORD=

# ---------- Job & freelance track (plain SMTP, separate inbox recommended) ----------
# Falls back to SMTP_* when empty
JOB_SMTP_HOST=smtp.gmail.com
JOB_SMTP_PORT=587
JOB_SMTP_USER=
JOB_SMTP_PASSWORD=

# ---------- Reacher identity (a domain you send from) ----------
REACHER_HELLO_NAME=localhost
REACHER_FROM_EMAIL=hello@localhost

# ---------- Time zone for Listmonk ----------
TZ=UTC

# ---------- Service logins + database passwords: generated by `openprospect init` ----------
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=
LISTMONK_DB_PASSWORD=
TWENTY_DB_PASSWORD=
TWENTY_ENCRYPTION_KEY=
HUGINN_USERNAME=admin
HUGINN_PASSWORD=
# random per install: the secret in the Huginn buyer-intent feed URL
HUGINN_FEED_SECRET=

# ---------- Optional: network exposure ----------
# Ports are published on this address only. 127.0.0.1 = this machine only (safe default).
# 0.0.0.0 exposes them to the network: only behind a firewall / reverse proxy with auth
# (Reacher has no auth; Twenty sign-up is open).
# BIND_ADDRESS=127.0.0.1

# ---------- Optional: image tags (default latest; pin these for production) ----------
# TWENTY_TAG=latest
# LISTMONK_TAG=latest
# REACHER_TAG=latest
# HUGINN_TAG=latest
# FIRECRAWL_TAG=latest
# MAPS_SCRAPER_TAG=latest

# ---------- Optional: host ports (defaults shown) ----------
# TWENTY_PORT=3740
# LISTMONK_PORT=3741
# REACHER_PORT=3742
# HUGINN_PORT=3743
# FIRECRAWL_PORT=3744
# MAPS_UI_PORT=3745

# ---------- Optional: running on a server ----------
# Public URL of Twenty and Huginn's host:port when not on localhost
# TWENTY_SERVER_URL=https://crm.example.com
# HUGINN_DOMAIN=intent.example.com
# HUGINN_TIMEZONE=UTC
# Only for the `runner` compose profile: the HOST's absolute path to this repo's data/ folder,
# e.g. /srv/openprospect/data (the Maps scraper is started on the host's Docker)
OPENPROSPECT_HOST_DATA_DIR=
